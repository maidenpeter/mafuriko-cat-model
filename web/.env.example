# Copy this file to .env.local and fill in the keys. .env.local is never committed.

# Which service runs the agents: openai or gemini.
# Left blank: OpenAI when OPENAI_API_KEY is set, otherwise Gemini.
AGENT_PROVIDER=

# ---- OpenAI ----
# One key serves all four agents.
OPENAI_API_KEY=

# Optional. Defaults to gpt-6-luna, the quick low-cost model.
# gpt-6.1-sol reasons more carefully and costs 20 times as much per token.
OPENAI_MODEL=

# Optional: low (default here), medium or high.
OPENAI_REASONING_EFFORT=

# Optional. Seconds to wait for one agent before giving up. Defaults to 150.
OPENAI_TIMEOUT_S=

# ---- Gemini ----
# One key per agent keeps each inside its own free-tier limit.
GEMINI_API_KEY_OPTIMIST=
GEMINI_API_KEY_CAUTIOUS=
GEMINI_API_KEY_CRITIC=
GEMINI_API_KEY_CHAIR=

# Used by any agent that has no key of its own.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Optional, Gemini 3 models only: low (default here), medium or high.
GEMINI_THINKING_LEVEL=

# Optional. Seconds to wait for one agent before giving up. Defaults to 150.
GEMINI_TIMEOUT_S=

# ---- Model data ----
# Folder holding the model inputs (hazard rasters, exposure CSV, hotspots). The files are
# read in place and never copied. Left blank: ../data/data, relative to this web folder.
# A relative value is also taken from this web folder. When the folder is missing the app
# opens with public/sample-data.zip instead and says so on screen.
MODEL_DATA_DIR=

# ---- Estimated cost ----
# Optional. Price per million tokens in US dollars, used only to show an estimated cost;
# leave empty to show no cost.
# OpenAI, price per million tokens sent in.
OPENAI_PRICE_IN_PER_M=
# OpenAI, price per million tokens sent back.
OPENAI_PRICE_OUT_PER_M=
# Gemini, price per million tokens sent in.
GEMINI_PRICE_IN_PER_M=
# Gemini, price per million tokens sent back.
GEMINI_PRICE_OUT_PER_M=
